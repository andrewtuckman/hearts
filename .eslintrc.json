{
  "extends": ["react-app", "react-app/jest"],
  "rules": {
    // enforce no space before function parentheses (use TS rule to avoid plugin conflicts)
    // allow space for async arrow functions
    "space-before-function-paren": "off",
    "@typescript-eslint/space-before-function-paren": [
      "error",
      {
        "anonymous": "always",
        "named": "never",
        "asyncArrow": "always"
      }
    ],

    // disallow trailing whitespace at the ends of lines
    "no-trailing-spaces": "error",

    // disallow multiple empty lines; no empty lines at EOF
    "no-multiple-empty-lines": ["error", { "max": 1, "maxEOF": 0 }],

    // enforce semicolons at end of statements via the TS ESLint rule
    "semi": "off",
    "@typescript-eslint/semi": ["error", "always"]
  }
}
